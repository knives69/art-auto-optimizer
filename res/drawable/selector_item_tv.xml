<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado enfocado con el mando de la TV o seleccionado en ListView -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1D4ED8" />
            <stroke android:width="3dp" android:color="#93C5FD" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1D4ED8" />
            <stroke android:width="3dp" android:color="#93C5FD" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1D4ED8" />
            <stroke android:width="3dp" android:color="#93C5FD" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Estado presionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2563EB" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Estado normal en reposo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2024" />
            <stroke android:width="1dp" android:color="#2D3139" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
